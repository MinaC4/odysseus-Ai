ARG ODYSSEUS_BASE=ghcr.io/odysseus-dev/odysseus@sha256:fdf83124b906a67a3218b20d8e7f22c5514982da4cebfd965019728922f3df2e
FROM node:20-alpine AS workspace
WORKDIR /workspace
COPY integrations/productivity/package*.json ./
RUN npm ci --ignore-scripts
COPY integrations/productivity/ ./
RUN npm run build

FROM ${ODYSSEUS_BASE}
WORKDIR /app
COPY app.py ./app.py
COPY core/database.py ./core/database.py
COPY src/ ./src/
COPY routes/hephastos_routes.py routes/productivity_routes.py routes/productivity_script_routes.py ./routes/
COPY services/hephastos.py services/productivity.py services/productivity_proposals.py services/productivity_scripts.py ./services/
COPY services/productivity_reminders.py ./services/productivity_reminders.py
COPY services/hephastos_context.py ./services/hephastos_context.py
COPY scripts/migrate_hephastos_workspace.py ./scripts/migrate_hephastos_workspace.py
COPY static/ ./static/
COPY --from=workspace /static/productivity/ ./static/productivity/
COPY tests/test_hephastos_workspace_integration.py ./integration-tests/test_workspace.py
